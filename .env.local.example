# ══════════════════════════════════════════════════════════════
# E-Broker - Environment Variables (local Docker Compose)
# Copy this to .env.local for host-side runs (venv/pytest/npm dev).
# NEVER commit .env.local to git (it is git-ignored).
# The compose stack itself carries its own values in docker-compose.yaml;
# see docs/ENV_SETUP.md for the full secrets guide.
# ══════════════════════════════════════════════════════════════

# ── Database (host-side; compose uses service name `postgres`) ──
DATABASE_URL=postgresql+asyncpg://ebroker:ebroker_dev_password@localhost:5432/ebroker
DATABASE_URL_SYNC=postgresql://ebroker:ebroker_dev_password@localhost:5432/ebroker

# ── S3-compatible storage (Elestio MinIO; NOT real AWS) ──────────
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_DEFAULT_REGION=ap-south-1
S3_BUCKET=ebroker-images
S3_MODEL_BUCKET=ebroker-models

# ── Auth ─────────────────────────────────────────────────────────
# Local dev uses a static admin bypass token (never in real prod).
ADMIN_JWT_BYPASS=true
ADMIN_JWT_BYPASS_TOKEN=dev-admin-token
NEXTAUTH_SECRET=ebroker-local-dev-secret-change-in-prod
NEXTAUTH_URL=http://localhost:3000

# ── ML Inference ─────────────────────────────────────────────────
MOCK_INFERENCE=false
ACTIVE_MODEL_PATH=models/best_yolo26.pt
INFERENCE_CONF_THRESHOLD=0.20
INFERENCE_MAX_DETECTIONS=50

# ── Training (local job runner; no GPU vendor) ───────────────────
TRAINING_TRIGGER_THRESHOLD=200

# ── Internal API ─────────────────────────────────────────────────
# Server-to-server key for /internal/* (injected server-side; the
# browser never sees it - see app/api/internal/*/route.ts proxies).
INTERNAL_API_KEY=test-internal-key
INTERNAL_API_URL=http://localhost:8000

# ── Agent (Ollama) ───────────────────────────────────────────────
# Cloud model via host Ollama. Containers reach it through the
# forwarder on :11435 (scripts/ollama_forwarder.py) because Ollama
# binds 127.0.0.1 only. Host-side tools use :11434 directly.
AGENT_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud
AGENT_MOCK=false
AGENT_TIMEOUT_S=300

# ── Pricing ──────────────────────────────────────────────────────
# Static reference table (api/core/metal_prices.py). metals.dev free
# tier is exhausted - leave METALS_API_KEY empty.
METALS_API_URL=https://api.metals.dev/v1/latest
METALS_API_KEY=
METALS_API_CURRENCY=INR
METALS_API_UNIT=g
EXCHANGE_RATE_API_KEY=

# ── Frontend ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=
# Must match ADMIN_JWT_BYPASS_TOKEN for local admin API calls.
NEXT_PUBLIC_ADMIN_TOKEN=dev-admin-token
ALLOW_DEV_ADMIN=true

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
